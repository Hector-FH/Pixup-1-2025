<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-configuration PUBLIC
		"-//Hibernate/Hibernate Configuration DTD 3.0//EN"
		"http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
	<session-factory>
		<property name="hibernate.connection.driver_class">com.mysql.cj.jdbc.Driver</property>
		<property name="hibernate.connection.url">jdbc:mysql://localhost:3306/pixup_hibernate</property>
		<property name="hibernate.connection.username">root</property>
		<property name="hibernate.connection.password">jetfuel</property>
		<property name="hibernate.default_schema">pixup_hibernate</property>
		<property name="hibernate.dialect">org.hibernate.dialect.MySQL8Dialect</property>
		<!-- JDBC connection pool (use the built-in) -->
		<property name="connection.pool.size">1</property>
		<property name="current_session_context_class">thread</property>
		<!-- Disable the second-level cache  -->
		<property name="cache.provider_class">org.hibernate.cache.internal.NoCachingRegionFactory</property>
		<!-- Echo all executed SQL to stdout -->
		<property name="show_sql">true</property>
		<!-- Drop and re-create the database schema on startup -->
		<property name="hbm2ddl.auto">none</property>
		<property name="hibernate.transform_hbm_xml.enabled">true</property>
		<mapping class="org.hectorfh.pixup.model.Estado"/>
		<mapping class="org.hectorfh.pixup.model.Municipio"/>
		<mapping class="org.hectorfh.pixup.model.Colonia"/>
		<mapping class="org.hectorfh.pixup.model.Domicilio"/>
		<mapping class="org.hectorfh.pixup.model.TDomicilio"/>
		<mapping class="org.hectorfh.pixup.model.Usuario"/>
		<mapping class="org.hectorfh.pixup.model.Orden"/>
		<mapping class="org.hectorfh.pixup.model.Cancion"/>
		<mapping class="org.hectorfh.pixup.model.Artista"/>
		<mapping class="org.hectorfh.pixup.model.Disquera"/>
		<mapping class="org.hectorfh.pixup.model.GeneroMusical"/>
		<mapping class="org.hectorfh.pixup.model.Disco"/>
		<mapping class="org.hectorfh.pixup.model.TipoNotificacion"/>
		<mapping class="org.hectorfh.pixup.model.Notificacion"/>
		<mapping class="org.hectorfh.pixup.model.Pago"/>
		<mapping class="org.hectorfh.pixup.model.DetalleOrden"/>

    </session-factory>
</hibernate-configuration>
